{
  "name": "Lending Lead",
  "module": "ZENVIQ Lending",
  "doctype": "DocType",
  "engine": "InnoDB",
  "naming_rule": "Expression",
  "autoname": "ZLEAD-.#####",
  "is_submittable": 0,
  "track_changes": 1,
  "allow_rename": 0,
  "sort_field": "creation",
  "sort_order": "DESC",
  "fields": [
    {"fieldname": "applicant_name", "fieldtype": "Data", "label": "Applicant Name", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "mobile_number", "fieldtype": "Data", "label": "Mobile Number", "reqd": 1, "options": "Phone"},
    {"fieldname": "email", "fieldtype": "Data", "label": "Email", "options": "Email"},
    {"fieldname": "column_break_1", "fieldtype": "Column Break"},
    {"fieldname": "lead_source", "fieldtype": "Select", "label": "Lead Source", "options": "\nWalk-in\nOnline Application\nDSA / Agent\nReferral\nSocial Media\nTelecalling", "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "lead_status", "fieldtype": "Select", "label": "Lead Status", "options": "\nNew\nContacted\nInterested\nNot Interested\nConverted\nLost", "default": "New", "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "assigned_to", "fieldtype": "Link", "label": "Assigned To", "options": "User"},
    {"fieldname": "section_loan_requirement", "fieldtype": "Section Break", "label": "Loan Requirement"},
    {"fieldname": "loan_type_requested", "fieldtype": "Select", "label": "Loan Type Requested", "options": "\nPersonal Loan\nBusiness Loan\nConsumer Durable Loan\nTwo Wheeler Loan"},
    {"fieldname": "requested_amount", "fieldtype": "Currency", "label": "Requested Amount", "in_list_view": 1},
    {"fieldname": "column_break_2", "fieldtype": "Column Break"},
    {"fieldname": "employment_type", "fieldtype": "Select", "label": "Employment Type", "options": "\nSalaried\nSelf Employed\nBusiness Owner\nFreelancer\nRetired"},
    {"fieldname": "monthly_income", "fieldtype": "Currency", "label": "Monthly Income (Approx)"},
    {"fieldname": "section_address", "fieldtype": "Section Break", "label": "Address Details"},
    {"fieldname": "city", "fieldtype": "Data", "label": "City"},
    {"fieldname": "state", "fieldtype": "Data", "label": "State"},
    {"fieldname": "pincode", "fieldtype": "Data", "label": "Pincode"},
    {"fieldname": "column_break_3", "fieldtype": "Column Break"},
    {"fieldname": "full_address", "fieldtype": "Small Text", "label": "Full Address"},
    {"fieldname": "section_notes", "fieldtype": "Section Break", "label": "Notes"},
    {"fieldname": "remarks", "fieldtype": "Text", "label": "Remarks"},
    {"fieldname": "next_follow_up", "fieldtype": "Date", "label": "Next Follow Up Date"},
    {"fieldname": "section_conversion", "fieldtype": "Section Break", "label": "Conversion", "depends_on": "eval:doc.lead_status=='Converted'"},
    {"fieldname": "borrower_profile", "fieldtype": "Link", "label": "Borrower Profile", "options": "Borrower Profile", "read_only": 1},
    {"fieldname": "loan_application", "fieldtype": "Link", "label": "Loan Application", "options": "Loan Application", "read_only": 1}
  ],
  "permissions": [
    {"role": "Lending Officer", "read": 1, "write": 1, "create": 1, "delete": 0},
    {"role": "Lending Admin", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1}
  ],
  "links": [
    {"link_doctype": "Borrower Profile", "link_fieldname": "lending_lead"},
    {"link_doctype": "Loan Application", "link_fieldname": "lending_lead"}
  ]
}
