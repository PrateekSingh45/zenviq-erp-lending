{
  "name": "Borrower Profile",
  "module": "ZENVIQ Lending",
  "doctype": "DocType",
  "engine": "InnoDB",
  "naming_rule": "Expression",
  "autoname": "ZBOR-.#####",
  "is_submittable": 0,
  "track_changes": 1,
  "allow_rename": 0,
  "image_field": "photo",
  "sort_field": "creation",
  "sort_order": "DESC",
  "fields": [
    {"fieldname": "full_name", "fieldtype": "Data", "label": "Full Name", "reqd": 1, "in_list_view": 1, "bold": 1},
    {"fieldname": "date_of_birth", "fieldtype": "Date", "label": "Date of Birth"},
    {"fieldname": "gender", "fieldtype": "Select", "label": "Gender", "options": "\nMale\nFemale\nOther"},
    {"fieldname": "photo", "fieldtype": "Attach Image", "label": "Photo"},
    {"fieldname": "column_break_1", "fieldtype": "Column Break"},
    {"fieldname": "mobile_number", "fieldtype": "Data", "label": "Mobile Number", "reqd": 1, "options": "Phone"},
    {"fieldname": "email", "fieldtype": "Data", "label": "Email", "options": "Email"},
    {"fieldname": "pan_number", "fieldtype": "Data", "label": "PAN Number"},
    {"fieldname": "aadhaar_number", "fieldtype": "Data", "label": "Aadhaar Number"},
    {"fieldname": "section_kyc", "fieldtype": "Section Break", "label": "KYC Status"},
    {"fieldname": "kyc_status", "fieldtype": "Select", "label": "KYC Status", "options": "\nPending\nIn Progress\nVerified\nRejected", "default": "Pending", "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "kyc_verified_on", "fieldtype": "Datetime", "label": "KYC Verified On", "read_only": 1, "depends_on": "eval:doc.kyc_status=='Verified'"},
    {"fieldname": "column_break_kyc", "fieldtype": "Column Break"},
    {"fieldname": "aadhaar_verified", "fieldtype": "Check", "label": "Aadhaar Verified", "read_only": 1},
    {"fieldname": "pan_verified", "fieldtype": "Check", "label": "PAN Verified", "read_only": 1},
    {"fieldname": "bank_verified", "fieldtype": "Check", "label": "Bank Statement Verified", "read_only": 1},
    {"fieldname": "section_employment", "fieldtype": "Section Break", "label": "Employment & Income"},
    {"fieldname": "employment_type", "fieldtype": "Select", "label": "Employment Type", "options": "\nSalaried\nSelf Employed\nBusiness Owner\nFreelancer\nRetired", "in_standard_filter": 1},
    {"fieldname": "employer_name", "fieldtype": "Data", "label": "Employer / Business Name"},
    {"fieldname": "designation", "fieldtype": "Data", "label": "Designation"},
    {"fieldname": "column_break_emp", "fieldtype": "Column Break"},
    {"fieldname": "monthly_income", "fieldtype": "Currency", "label": "Monthly Income", "in_list_view": 1},
    {"fieldname": "years_in_current_job", "fieldtype": "Int", "label": "Years in Current Job"},
    {"fieldname": "total_work_experience", "fieldtype": "Int", "label": "Total Work Experience (Years)"},
    {"fieldname": "section_credit", "fieldtype": "Section Break", "label": "Credit Information"},
    {"fieldname": "credit_score", "fieldtype": "Int", "label": "Credit Score (CIBIL)", "read_only": 1},
    {"fieldname": "credit_score_date", "fieldtype": "Date", "label": "Credit Score Date", "read_only": 1},
    {"fieldname": "risk_category", "fieldtype": "Select", "label": "Risk Category", "options": "\nA - Low Risk\nB - Moderate Risk\nC - Medium Risk\nD - High Risk\nE - Very High Risk", "read_only": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "column_break_credit", "fieldtype": "Column Break"},
    {"fieldname": "existing_loan_count", "fieldtype": "Int", "label": "Existing Loan Count", "read_only": 1},
    {"fieldname": "existing_emi_total", "fieldtype": "Currency", "label": "Existing EMI Total", "read_only": 1},
    {"fieldname": "credit_report_sandbox", "fieldtype": "Code", "label": "Credit Bureau Report (Sandbox)", "options": "JSON", "read_only": 1, "hidden": 1},
    {"fieldname": "section_address", "fieldtype": "Section Break", "label": "Address"},
    {"fieldname": "address", "fieldtype": "Small Text", "label": "Current Address"},
    {"fieldname": "city", "fieldtype": "Data", "label": "City"},
    {"fieldname": "state", "fieldtype": "Data", "label": "State"},
    {"fieldname": "pincode", "fieldtype": "Data", "label": "Pincode"},
    {"fieldname": "column_break_addr", "fieldtype": "Column Break"},
    {"fieldname": "permanent_address", "fieldtype": "Small Text", "label": "Permanent Address"},
    {"fieldname": "section_references", "fieldtype": "Section Break", "label": "References"},
    {"fieldname": "lending_lead", "fieldtype": "Link", "label": "Lending Lead", "options": "Lending Lead", "read_only": 1},
    {"fieldname": "customer", "fieldtype": "Link", "label": "Customer (ERPNext)", "options": "Customer", "read_only": 1},
    {"fieldname": "column_break_ref", "fieldtype": "Column Break"},
    {"fieldname": "reference1_name", "fieldtype": "Data", "label": "Reference 1 - Name"},
    {"fieldname": "reference1_phone", "fieldtype": "Data", "label": "Reference 1 - Phone", "options": "Phone"},
    {"fieldname": "reference1_relation", "fieldtype": "Data", "label": "Reference 1 - Relation"},
    {"fieldname": "section_notes", "fieldtype": "Section Break", "label": "Notes"},
    {"fieldname": "remarks", "fieldtype": "Text", "label": "Remarks"}
  ],
  "permissions": [
    {"role": "Lending Officer", "read": 1, "write": 1, "create": 1, "delete": 0},
    {"role": "Credit Analyst", "read": 1, "write": 1, "create": 0},
    {"role": "Lending Admin", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1}
  ],
  "links": [
    {"link_doctype": "Lending Lead", "link_fieldname": "borrower_profile"},
    {"link_doctype": "KYC Verification", "link_fieldname": "borrower_profile"},
    {"link_doctype": "Credit Assessment", "link_fieldname": "borrower_profile"},
    {"link_doctype": "Loan Application", "link_fieldname": "borrower_profile"}
  ]
}
