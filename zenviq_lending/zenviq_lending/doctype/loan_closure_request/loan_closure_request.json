{
  "name": "Loan Closure Request",
  "module": "ZENVIQ Lending",
  "doctype": "DocType",
  "engine": "InnoDB",
  "naming_rule": "Expression",
  "autoname": "ZCLOSE-.#####",
  "is_submittable": 1,
  "track_changes": 1,
  "sort_field": "creation",
  "sort_order": "DESC",
  "fields": [
    {"fieldname": "loan", "fieldtype": "Link", "label": "Loan", "options": "Loan", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "borrower_profile", "fieldtype": "Link", "label": "Borrower", "options": "Borrower Profile", "reqd": 1, "in_list_view": 1},
    {"fieldname": "borrower_name", "fieldtype": "Data", "label": "Borrower Name", "fetch_from": "borrower_profile.full_name", "read_only": 1, "in_list_view": 1},
    {"fieldname": "column_break_1", "fieldtype": "Column Break"},
    {"fieldname": "closure_type", "fieldtype": "Select", "label": "Closure Type", "options": "\nRegular Closure\nForeclosure\nSettlement", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "closure_date", "fieldtype": "Date", "label": "Closure Date", "default": "Today", "reqd": 1},
    {"fieldname": "closure_status", "fieldtype": "Select", "label": "Status", "options": "\nPending\nApproved\nCompleted\nRejected", "default": "Pending", "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "section_amounts", "fieldtype": "Section Break", "label": "Settlement Details"},
    {"fieldname": "total_loan_amount", "fieldtype": "Currency", "label": "Total Loan Amount"},
    {"fieldname": "total_paid", "fieldtype": "Currency", "label": "Total Amount Paid"},
    {"fieldname": "principal_outstanding", "fieldtype": "Currency", "label": "Principal Outstanding", "bold": 1},
    {"fieldname": "column_break_amt", "fieldtype": "Column Break"},
    {"fieldname": "interest_outstanding", "fieldtype": "Currency", "label": "Interest Outstanding"},
    {"fieldname": "penal_charges", "fieldtype": "Currency", "label": "Penal Charges"},
    {"fieldname": "foreclosure_charges", "fieldtype": "Currency", "label": "Foreclosure/Settlement Charges", "depends_on": "eval:doc.closure_type!='Regular Closure'"},
    {"fieldname": "total_settlement_amount", "fieldtype": "Currency", "label": "Total Settlement Amount", "bold": 1},
    {"fieldname": "section_noc", "fieldtype": "Section Break", "label": "NOC Details"},
    {"fieldname": "noc_generated", "fieldtype": "Check", "label": "NOC Generated"},
    {"fieldname": "noc_date", "fieldtype": "Date", "label": "NOC Date"},
    {"fieldname": "noc_number", "fieldtype": "Data", "label": "NOC Number", "read_only": 1},
    {"fieldname": "column_break_noc", "fieldtype": "Column Break"},
    {"fieldname": "security_released", "fieldtype": "Check", "label": "Security/Collateral Released"},
    {"fieldname": "cibil_updated", "fieldtype": "Check", "label": "CIBIL Status Updated (Sandbox)"},
    {"fieldname": "section_remarks", "fieldtype": "Section Break", "label": "Remarks"},
    {"fieldname": "remarks", "fieldtype": "Text", "label": "Remarks"},
    {"fieldname": "sandbox_disclaimer", "fieldtype": "HTML", "label": "", "options": "<div class='alert alert-info'><strong>ℹ️ POC Note:</strong> NOC generation and CIBIL update are simulated in this demonstration.</div>"}
  ],
  "permissions": [
    {"role": "Lending Officer", "read": 1, "write": 1, "create": 1, "submit": 0},
    {"role": "Branch Manager Lending", "read": 1, "write": 1, "create": 1, "submit": 1, "cancel": 1},
    {"role": "Lending Admin", "read": 1, "write": 1, "create": 1, "submit": 1, "cancel": 1, "delete": 1},
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "submit": 1, "cancel": 1, "delete": 1}
  ],
  "links": []
}
