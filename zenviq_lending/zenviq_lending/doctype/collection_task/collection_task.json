{
  "name": "Collection Task",
  "module": "ZENVIQ Lending",
  "doctype": "DocType",
  "engine": "InnoDB",
  "naming_rule": "Expression",
  "autoname": "ZCOLL-.#####",
  "is_submittable": 0,
  "track_changes": 1,
  "sort_field": "creation",
  "sort_order": "DESC",
  "fields": [
    {"fieldname": "loan", "fieldtype": "Link", "label": "Loan", "options": "Loan", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "borrower_profile", "fieldtype": "Link", "label": "Borrower", "options": "Borrower Profile", "reqd": 1, "in_list_view": 1},
    {"fieldname": "borrower_name", "fieldtype": "Data", "label": "Borrower Name", "fetch_from": "borrower_profile.full_name", "read_only": 1, "in_list_view": 1},
    {"fieldname": "column_break_1", "fieldtype": "Column Break"},
    {"fieldname": "collection_status", "fieldtype": "Select", "label": "Status", "options": "\nNew\nContacted\nPromise to Pay\nPartially Paid\nEscalated\nResolved\nWrite Off", "default": "New", "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "priority", "fieldtype": "Select", "label": "Priority", "options": "\nLow\nMedium\nHigh\nCritical", "default": "Medium", "in_standard_filter": 1},
    {"fieldname": "assigned_collector", "fieldtype": "Link", "label": "Assigned Collector", "options": "User"},
    {"fieldname": "section_overdue", "fieldtype": "Section Break", "label": "Overdue Details"},
    {"fieldname": "overdue_amount", "fieldtype": "Currency", "label": "Overdue Amount", "reqd": 1, "in_list_view": 1, "bold": 1},
    {"fieldname": "overdue_emi_count", "fieldtype": "Int", "label": "Overdue EMI Count"},
    {"fieldname": "dpd_days", "fieldtype": "Int", "label": "DPD (Days Past Due)", "bold": 1, "in_list_view": 1},
    {"fieldname": "column_break_overdue", "fieldtype": "Column Break"},
    {"fieldname": "dpd_bucket", "fieldtype": "Select", "label": "DPD Bucket", "options": "\n0 DPD\n1-30 DPD\n31-60 DPD\n61-90 DPD\n90+ DPD (NPA)", "in_standard_filter": 1, "bold": 1},
    {"fieldname": "first_overdue_date", "fieldtype": "Date", "label": "First Overdue Date"},
    {"fieldname": "penal_interest", "fieldtype": "Currency", "label": "Penal Interest Accrued"},
    {"fieldname": "section_follow_up", "fieldtype": "Section Break", "label": "Follow-up"},
    {"fieldname": "promise_to_pay_date", "fieldtype": "Date", "label": "Promise to Pay Date"},
    {"fieldname": "next_follow_up", "fieldtype": "Date", "label": "Next Follow-Up Date"},
    {"fieldname": "column_break_followup", "fieldtype": "Column Break"},
    {"fieldname": "last_contact_date", "fieldtype": "Date", "label": "Last Contact Date"},
    {"fieldname": "contact_attempts", "fieldtype": "Int", "label": "Contact Attempts", "default": 0},
    {"fieldname": "section_action_log", "fieldtype": "Section Break", "label": "Action Log"},
    {"fieldname": "action_log", "fieldtype": "Table", "label": "Collection Actions", "options": "Collection Action Log"},
    {"fieldname": "section_remarks", "fieldtype": "Section Break", "label": "Remarks"},
    {"fieldname": "remarks", "fieldtype": "Text", "label": "Remarks"}
  ],
  "permissions": [
    {"role": "Collections Officer", "read": 1, "write": 1, "create": 1},
    {"role": "Branch Manager Lending", "read": 1, "write": 1, "create": 1},
    {"role": "Lending Admin", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1}
  ],
  "links": []
}
