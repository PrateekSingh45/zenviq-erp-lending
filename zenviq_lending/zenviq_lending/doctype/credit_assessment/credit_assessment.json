{
  "name": "Credit Assessment",
  "module": "ZENVIQ Lending",
  "doctype": "DocType",
  "engine": "InnoDB",
  "naming_rule": "Expression",
  "autoname": "ZCRED-.#####",
  "is_submittable": 1,
  "track_changes": 1,
  "sort_field": "creation",
  "sort_order": "DESC",
  "fields": [
    {"fieldname": "borrower_profile", "fieldtype": "Link", "label": "Borrower Profile", "options": "Borrower Profile", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "borrower_name", "fieldtype": "Data", "label": "Borrower Name", "fetch_from": "borrower_profile.full_name", "read_only": 1, "in_list_view": 1},
    {"fieldname": "loan_application", "fieldtype": "Link", "label": "Loan Application", "options": "Loan Application"},
    {"fieldname": "column_break_1", "fieldtype": "Column Break"},
    {"fieldname": "assessment_date", "fieldtype": "Date", "label": "Assessment Date", "default": "Today", "reqd": 1},
    {"fieldname": "assessed_by", "fieldtype": "Link", "label": "Assessed By", "options": "User", "default": "__user"},
    {"fieldname": "assessment_status", "fieldtype": "Select", "label": "Assessment Status", "options": "\nDraft\nIn Progress\nCompleted\nReferred", "default": "Draft", "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "section_income", "fieldtype": "Section Break", "label": "Income Analysis"},
    {"fieldname": "declared_monthly_income", "fieldtype": "Currency", "label": "Declared Monthly Income", "fetch_from": "borrower_profile.monthly_income"},
    {"fieldname": "verified_monthly_income", "fieldtype": "Currency", "label": "Verified Monthly Income"},
    {"fieldname": "other_income", "fieldtype": "Currency", "label": "Other Income"},
    {"fieldname": "column_break_income", "fieldtype": "Column Break"},
    {"fieldname": "total_monthly_income", "fieldtype": "Currency", "label": "Total Monthly Income", "read_only": 1, "bold": 1},
    {"fieldname": "existing_emi", "fieldtype": "Currency", "label": "Existing EMI Obligations", "fetch_from": "borrower_profile.existing_emi_total"},
    {"fieldname": "proposed_emi", "fieldtype": "Currency", "label": "Proposed EMI"},
    {"fieldname": "section_ratios", "fieldtype": "Section Break", "label": "Financial Ratios"},
    {"fieldname": "foir", "fieldtype": "Percent", "label": "FOIR (Fixed Obligation to Income Ratio)", "read_only": 1, "bold": 1, "description": "Should be ≤ 50% for approval"},
    {"fieldname": "dti_ratio", "fieldtype": "Percent", "label": "DTI (Debt to Income Ratio)", "read_only": 1},
    {"fieldname": "column_break_ratio", "fieldtype": "Column Break"},
    {"fieldname": "net_monthly_surplus", "fieldtype": "Currency", "label": "Net Monthly Surplus", "read_only": 1},
    {"fieldname": "loan_amount_recommended", "fieldtype": "Currency", "label": "Recommended Loan Amount", "read_only": 1, "bold": 1},
    {"fieldname": "section_credit_score", "fieldtype": "Section Break", "label": "Credit Score & Risk"},
    {"fieldname": "credit_score", "fieldtype": "Int", "label": "Credit Score", "fetch_from": "borrower_profile.credit_score", "read_only": 1},
    {"fieldname": "risk_category", "fieldtype": "Select", "label": "Risk Category", "options": "\nA - Low Risk\nB - Moderate Risk\nC - Medium Risk\nD - High Risk\nE - Very High Risk", "fetch_from": "borrower_profile.risk_category", "in_list_view": 1},
    {"fieldname": "column_break_risk", "fieldtype": "Column Break"},
    {"fieldname": "overall_score", "fieldtype": "Int", "label": "Overall Assessment Score (out of 100)", "bold": 1},
    {"fieldname": "recommendation", "fieldtype": "Select", "label": "Recommendation", "options": "\nApprove\nApprove with Conditions\nRefer to Committee\nReject", "in_list_view": 1, "in_standard_filter": 1, "bold": 1},
    {"fieldname": "section_parameters", "fieldtype": "Section Break", "label": "Assessment Parameters"},
    {"fieldname": "assessment_parameters", "fieldtype": "Table", "label": "Parameters", "options": "Credit Assessment Parameter"},
    {"fieldname": "section_remarks", "fieldtype": "Section Break", "label": "Analyst Remarks"},
    {"fieldname": "analyst_remarks", "fieldtype": "Text Editor", "label": "Detailed Remarks"},
    {"fieldname": "conditions", "fieldtype": "Text", "label": "Conditions (if applicable)"}
  ],
  "permissions": [
    {"role": "Credit Analyst", "read": 1, "write": 1, "create": 1, "submit": 1, "cancel": 0},
    {"role": "Loan Approver", "read": 1, "write": 0, "create": 0, "submit": 0},
    {"role": "Lending Admin", "read": 1, "write": 1, "create": 1, "submit": 1, "cancel": 1, "delete": 1},
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "submit": 1, "cancel": 1, "delete": 1}
  ],
  "links": []
}
