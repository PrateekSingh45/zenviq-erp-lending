{
  "name": "eSign Request",
  "module": "ZENVIQ Lending",
  "doctype": "DocType",
  "engine": "InnoDB",
  "naming_rule": "Expression",
  "autoname": "ZSGN-.#####",
  "is_submittable": 0,
  "track_changes": 1,
  "sort_field": "creation",
  "sort_order": "DESC",
  "fields": [
    {"fieldname": "borrower_profile", "fieldtype": "Link", "label": "Borrower Profile", "options": "Borrower Profile", "reqd": 1, "in_list_view": 1},
    {"fieldname": "borrower_name", "fieldtype": "Data", "label": "Borrower Name", "fetch_from": "borrower_profile.full_name", "read_only": 1, "in_list_view": 1},
    {"fieldname": "document_type", "fieldtype": "Select", "label": "Document to Sign", "options": "\nLoan Agreement\nSanction Letter\nNACH Mandate\nEMI Schedule", "reqd": 1, "in_list_view": 1},
    {"fieldname": "column_break_1", "fieldtype": "Column Break"},
    {"fieldname": "loan", "fieldtype": "Link", "label": "Loan", "options": "Loan"},
    {"fieldname": "esign_status", "fieldtype": "Select", "label": "eSign Status", "options": "\nPending\nOTP Sent\nSigned\nFailed\nExpired", "default": "Pending", "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "esign_provider", "fieldtype": "Data", "label": "eSign Provider", "default": "Sandbox - Aadhaar eSign", "read_only": 1},
    {"fieldname": "section_details", "fieldtype": "Section Break", "label": "Signing Details"},
    {"fieldname": "document_file", "fieldtype": "Attach", "label": "Document File (Unsigned)"},
    {"fieldname": "signed_document", "fieldtype": "Attach", "label": "Signed Document", "read_only": 1},
    {"fieldname": "column_break_det", "fieldtype": "Column Break"},
    {"fieldname": "otp_sent_at", "fieldtype": "Datetime", "label": "OTP Sent At", "read_only": 1},
    {"fieldname": "signed_at", "fieldtype": "Datetime", "label": "Signed At", "read_only": 1},
    {"fieldname": "esign_transaction_id", "fieldtype": "Data", "label": "eSign Transaction ID", "read_only": 1},
    {"fieldname": "digital_signature_hash", "fieldtype": "Data", "label": "Digital Signature Hash", "read_only": 1},
    {"fieldname": "section_response", "fieldtype": "Section Break", "label": "Sandbox Response", "collapsible": 1},
    {"fieldname": "sandbox_response", "fieldtype": "Code", "label": "API Response", "options": "JSON", "read_only": 1},
    {"fieldname": "sandbox_disclaimer", "fieldtype": "HTML", "label": "", "options": "<div class='alert alert-warning'><strong>⚠️ Sandbox Mode:</strong> This eSign is simulated for demonstration. In production, this will integrate with a licensed Aadhaar eSign provider (e.g., Leegality, DigiSign).</div>"}
  ],
  "permissions": [
    {"role": "Lending Officer", "read": 1, "write": 1, "create": 1},
    {"role": "Lending Admin", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1}
  ],
  "links": []
}
