{
  "name": "KYC Verification",
  "module": "ZENVIQ Lending",
  "doctype": "DocType",
  "engine": "InnoDB",
  "naming_rule": "Expression",
  "autoname": "ZKYC-.#####",
  "is_submittable": 1,
  "track_changes": 1,
  "sort_field": "creation",
  "sort_order": "DESC",
  "fields": [
    {"fieldname": "borrower_profile", "fieldtype": "Link", "label": "Borrower Profile", "options": "Borrower Profile", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "borrower_name", "fieldtype": "Data", "label": "Borrower Name", "fetch_from": "borrower_profile.full_name", "read_only": 1, "in_list_view": 1},
    {"fieldname": "column_break_1", "fieldtype": "Column Break"},
    {"fieldname": "verification_status", "fieldtype": "Select", "label": "Verification Status", "options": "\nPending\nIn Progress\nApproved\nRejected", "default": "Pending", "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "verified_by", "fieldtype": "Link", "label": "Verified By", "options": "User", "read_only": 1},
    {"fieldname": "verified_on", "fieldtype": "Datetime", "label": "Verified On", "read_only": 1},
    {"fieldname": "section_documents", "fieldtype": "Section Break", "label": "Documents"},
    {"fieldname": "kyc_documents", "fieldtype": "Table", "label": "KYC Documents", "options": "KYC Document Item", "reqd": 1},
    {"fieldname": "section_aadhaar", "fieldtype": "Section Break", "label": "Aadhaar Verification"},
    {"fieldname": "aadhaar_number", "fieldtype": "Data", "label": "Aadhaar Number", "fetch_from": "borrower_profile.aadhaar_number"},
    {"fieldname": "aadhaar_status", "fieldtype": "Select", "label": "Aadhaar eKYC Status", "options": "\nNot Started\nOTP Sent\nVerified\nFailed", "default": "Not Started"},
    {"fieldname": "aadhaar_response", "fieldtype": "Code", "label": "eKYC Response (Sandbox)", "options": "JSON", "read_only": 1},
    {"fieldname": "column_break_aad", "fieldtype": "Column Break"},
    {"fieldname": "pan_number", "fieldtype": "Data", "label": "PAN Number", "fetch_from": "borrower_profile.pan_number"},
    {"fieldname": "pan_status", "fieldtype": "Select", "label": "PAN Verification Status", "options": "\nNot Started\nVerified\nFailed", "default": "Not Started"},
    {"fieldname": "pan_response", "fieldtype": "Code", "label": "PAN Response (Sandbox)", "options": "JSON", "read_only": 1},
    {"fieldname": "section_bank", "fieldtype": "Section Break", "label": "Bank Statement Analysis"},
    {"fieldname": "bank_statement", "fieldtype": "Attach", "label": "Upload Bank Statement (PDF)"},
    {"fieldname": "bank_analysis_status", "fieldtype": "Select", "label": "Analysis Status", "options": "\nNot Started\nAnalyzing\nCompleted\nFailed", "default": "Not Started"},
    {"fieldname": "column_break_bank", "fieldtype": "Column Break"},
    {"fieldname": "avg_monthly_balance", "fieldtype": "Currency", "label": "Avg Monthly Balance", "read_only": 1},
    {"fieldname": "avg_monthly_credits", "fieldtype": "Currency", "label": "Avg Monthly Credits", "read_only": 1},
    {"fieldname": "avg_monthly_debits", "fieldtype": "Currency", "label": "Avg Monthly Debits", "read_only": 1},
    {"fieldname": "bank_analysis_response", "fieldtype": "Code", "label": "Bank Analysis (Sandbox)", "options": "JSON", "read_only": 1},
    {"fieldname": "section_remarks", "fieldtype": "Section Break", "label": "Remarks"},
    {"fieldname": "remarks", "fieldtype": "Text", "label": "Verification Remarks"}
  ],
  "permissions": [
    {"role": "Lending Officer", "read": 1, "write": 1, "create": 1, "submit": 1, "cancel": 0},
    {"role": "Credit Analyst", "read": 1, "write": 1, "create": 1, "submit": 1, "cancel": 1},
    {"role": "Lending Admin", "read": 1, "write": 1, "create": 1, "submit": 1, "cancel": 1, "delete": 1},
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "submit": 1, "cancel": 1, "delete": 1}
  ],
  "links": []
}
